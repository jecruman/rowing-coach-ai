---
import ScullMotif from "@/components/landing/ScullMotif.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { formatTime, signed } from "@/lib/services/profile/rules";

// Invented sample of one water session, formatted and labelled like SessionAnalysis.astro and SuggestionPanel.tsx.
// The numbers agree with each other and with the product's rules: 5000 m in 21:00 is 2:06 /500 m, and a clear DPS
// drop on water (−0.3 m or more) is the case where the safety limits cap the next session at 32 spm.
const SAMPLE_METRICS = [
  { label: "Pace /500 m", value: formatTime(126), delta: `${signed(-3)} s` },
  { label: "Split drift", value: `${signed(3)} s`, delta: `${signed(1)} s` },
  { label: "Stroke rate", value: "29 spm", delta: `${signed(2)} spm` },
  { label: "Distance per stroke", value: "8.2 m", delta: `${signed(-0.4)} m` },
];

const SAMPLE_LABELS = ["Distance per stroke: clear drop", "Technique may be limiting efficiency"];

const SAMPLE_SUGGESTION = [
  { label: "Total time", value: "24 min" },
  { label: "Max stroke rate", value: "32 spm" },
];

const STEPS = [
  {
    title: "Log the session",
    body: "Type in your erg or water row: distance, time, and whatever splits and stroke data you have.",
  },
  {
    title: "See the numbers",
    body: "Computed metrics against your last three sessions of that type, erg with erg and water with water.",
  },
  {
    title: "Get one next session",
    body: "One session with its structure, targets and reason, always within fixed safety limits.",
  },
  {
    title: "Mark it done or skipped",
    body: "Your mark carries forward, so the next suggestion reflects it.",
  },
];
---

<header class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-5 lg:px-8">
  <span class="font-display text-lg font-bold tracking-tight text-foreground">Rowing Coach AI</span>
  <a href="/auth/signin" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
    Sign in
  </a>
</header>

<main>
  <section class="mx-auto grid max-w-7xl grid-cols-1 gap-y-10 px-6 pt-10 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-14 lg:px-8 lg:pt-20">
    <div class="lg:order-1 lg:col-span-7 lg:self-center">
      <h1 class="font-display text-4xl leading-none font-extrabold tracking-tight text-balance text-foreground sm:text-5xl xl:text-6xl">
        Your next session, worked out from your last three.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
        Log an erg or water session and get computed numbers plus one next session, checked against fixed safety limits.
        Built for masters rowers with a goal and limited time.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/auth/signin" class:list={buttonVariants({ size: "lg" })}>
          Sign in
        </a>
        <p class="text-sm text-muted-foreground">Private for now: this coach is used by invitation.</p>
      </div>
    </div>

    <ScullMotif class="-mx-6 lg:order-3 lg:col-span-12 lg:mx-0" />

    <div class="lg:order-2 lg:col-span-5 lg:self-center">
      <Card className="gap-5">
        <CardHeader>
          <CardTitle role="heading" aria-level={2} className="text-xs font-medium tracking-widest uppercase">
            Example session, sample numbers
          </CardTitle>
          <CardDescription className="tabular-nums">Water · 5000 m in {formatTime(1260)}</CardDescription>
        </CardHeader>
        <CardContent className="space-y-5">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4">
            {SAMPLE_METRICS.map(({ label, value, delta }) => (
              <div>
                <dt class="text-xs text-muted-foreground">{label}</dt>
                <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">{value}</dd>
                <dd class="text-xs text-muted-foreground tabular-nums">{delta} vs last 3</dd>
              </div>
            ))}
          </dl>

          <ul class="space-y-1 border-t border-border pt-4 text-sm">
            {SAMPLE_LABELS.map((label) => (
              <li>{label}</li>
            ))}
          </ul>

          <div class="rounded-lg bg-coach p-4 text-coach-foreground">
            <h3 class="text-xs font-semibold tracking-widest uppercase">Next session</h3>
            <p class="mt-2 text-xl font-bold tracking-tight tabular-nums">6 × 2 min / 2 min rest</p>
            <dl class="mt-3 grid grid-cols-2 gap-x-6 text-sm">
              {SAMPLE_SUGGESTION.map(({ label, value }) => (
                <div>
                  <dt>{label}</dt>
                  <dd class="font-semibold tabular-nums">{value}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-3 text-sm">
              <span class="font-semibold">Focus:</span> longer strokes at a controlled rate, because distance per stroke
              dropped as the rate rose.
            </p>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24" aria-labelledby="how-it-works-heading">
    <h2 id="how-it-works-heading" class="font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      How it works
    </h2>
    <p class="mt-3 text-muted-foreground">The loop for invited rowers, after every row.</p>
    <ol class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {STEPS.map(({ title, body }, index) => (
        <li class="border-t border-border pt-5">
          <span
            class="font-display text-5xl font-extrabold tracking-tight text-primary tabular-nums"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <h3 class="mt-3 font-semibold text-foreground">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{body}</p>
        </li>
      ))}
    </ol>
  </section>
</main>
