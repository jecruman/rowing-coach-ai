---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  description?: string;
}

const APP_NAME = "Rowing Coach AI";
const DEFAULT_DESCRIPTION =
  "A private rowing coach: log erg and water sessions, see computed numbers, and get one safe next session.";
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${APP_NAME}` : APP_NAME;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
