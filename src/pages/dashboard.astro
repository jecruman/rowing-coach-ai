---
import Layout from "@/layouts/Layout.astro";
import AppNav from "@/components/AppNav.astro";
import DashboardView, { type DashboardGoal } from "@/components/dashboard/DashboardView.astro";
import { createClient } from "@/lib/supabase";
import { ageFromBirthYear, loadProfileAndGoals, type ProfileAndGoals } from "@/lib/services/profile/load";
import { formatTime } from "@/lib/services/profile/rules";
import { loadLatestSession, type SessionResult } from "@/lib/services/sessions/load";
import type { RowerGoal } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const [{ profile, goals, loadFailed }, latest]: [ProfileAndGoals, SessionResult] =
  supabase && user
    ? await Promise.all([loadProfileAndGoals(supabase, user.id), loadLatestSession(supabase)])
    : [
        { profile: null, goals: {}, loadFailed: false },
        { session: null, loadFailed: false },
      ];
// A failed latest-session read is logged by the loader and shown as an inline error by the view.
const latestSession = latest.session;

const goalList = [goals.erg, goals.water].filter((goal): goal is RowerGoal => goal !== undefined);
const needsSetup = profile === null || goalList.length === 0;

const age = ageFromBirthYear(profile?.birthYear ?? null);
const profileFacts = [profile?.boat ?? null, age === null ? null : `age ${String(age)}`].filter(
  (part): part is string => part !== null,
);
const goalRows: DashboardGoal[] = goalList.map((goal) => ({
  label: goal.sessionType === "erg" ? "Erg" : "Water",
  target: `${String(goal.distanceM)} m in ${formatTime(goal.targetSeconds)}`,
}));
---

<Layout title="Dashboard">
  <div class="min-h-screen bg-background p-4 text-foreground">
    <div class="mx-auto w-full max-w-2xl space-y-4">
      <AppNav current="dashboard" />
      <DashboardView
        email={user?.email ?? ""}
        profileLoadFailed={loadFailed}
        needsSetup={needsSetup}
        profileFacts={profileFacts}
        goals={goalRows}
        latestSession={latestSession}
        latestLoadFailed={latest.loadFailed}
      />
    </div>
  </div>
</Layout>
