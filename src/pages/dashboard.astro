---
import Layout from "@/layouts/Layout.astro";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";
import { ageFromBirthYear, loadProfileAndGoals, type ProfileAndGoals } from "@/lib/services/profile/load";
import { formatTime } from "@/lib/services/profile/rules";
import { loadLatestSession, type SessionResult } from "@/lib/services/sessions/load";
import type { RowerGoal } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const [{ profile, goals, loadFailed }, latest]: [ProfileAndGoals, SessionResult] =
  supabase && user
    ? await Promise.all([loadProfileAndGoals(supabase, user.id), loadLatestSession(supabase)])
    : [
        { profile: null, goals: {}, loadFailed: false },
        { session: null, loadFailed: false },
      ];
// A failed latest-session read only hides the link (it is logged by the loader).
const latestSession = latest.session;

const goalList = [goals.erg, goals.water].filter((goal): goal is RowerGoal => goal !== undefined);
const needsSetup = profile === null || goalList.length === 0;

const age = ageFromBirthYear(profile?.birthYear ?? null);
const summary = [
  profile?.boat ?? null,
  age === null ? null : `age ${String(age)}`,
  ...goalList.map(
    (goal) =>
      `${goal.sessionType === "erg" ? "Erg" : "Water"} ${String(goal.distanceM)} m in ${formatTime(goal.targetSeconds)}`,
  ),
]
  .filter((part): part is string => part !== null)
  .join(" · ");
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {loadFailed ? (
        <div class="mt-6 text-left">
          <ServerError message="Could not load your data — please try again." />
        </div>
      ) : needsSetup ? (
        <a
          href="/profile"
          class="mt-6 block rounded-lg bg-purple-600 px-4 py-3 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Set up your profile and goals
        </a>
      ) : (
        <>
          <p class="mt-4 text-sm text-blue-100/80">{summary}</p>
          <a href="/profile" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
            Edit profile
          </a>
        </>
      )}
      <a
        href="/sessions/new"
        class="mt-6 block rounded-lg bg-purple-600 px-4 py-3 font-medium text-white transition-colors hover:bg-purple-500"
      >
        Log a session
      </a>
      {latestSession && (
        <a href={`/sessions/${latestSession.id}`} class="mt-4 inline-block text-sm text-purple-300 hover:underline">
          Latest session: {latestSession.rowedOn} · {latestSession.type === "erg" ? "Erg" : "Water"} ·{" "}
          {latestSession.distanceM} m
        </a>
      )}
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
