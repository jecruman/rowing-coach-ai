---
import "@fontsource-variable/archivo/wght.css";
import LandingView from "@/components/landing/LandingView.astro";
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen bg-background">
    <header class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-5 lg:px-8">
      <span class="font-display text-lg font-bold tracking-tight text-foreground">Rowing Coach AI</span>
      <a href="/auth/signin" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
        Sign in
      </a>
    </header>
    <main>
      <LandingView />
    </main>
  </div>
</Layout>
