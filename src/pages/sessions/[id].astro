---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { ServerError } from "@/components/auth/ServerError";
import SessionAnalysis from "@/components/sessions/SessionAnalysis.astro";
import SuggestionPanel from "@/components/sessions/SuggestionPanel";
import DeleteSessionButton from "@/components/sessions/DeleteSessionButton";
import { createClient } from "@/lib/supabase";
import { isHardSession } from "@/lib/services/coaching/limits";
import { analyseSession } from "@/lib/services/coaching/metrics";
import { loadProfileAndGoals } from "@/lib/services/profile/load";
import { formatTime } from "@/lib/services/profile/rules";
import {
  loadSession,
  loadSessionsUpTo,
  loadStoredSuggestion,
  storedSuggestionPayload,
  type SessionResult,
} from "@/lib/services/sessions/load";
import type { NumberRange } from "@/types";

/** Longest `?error=` text shown; the param is link-controlled, so keep crafted text short. */
const MAX_ERROR_LENGTH = 200;

/** Rows of any type read for the analysis; enough to find the last 3 of the session's type in a mixed history. */
const HISTORY_LIMIT = 30;

const { user } = Astro.locals;
const id = Astro.params.id ?? "";
// Set by the delete endpoint when the delete failed.
const actionError = Astro.url.searchParams.get("error")?.slice(0, MAX_ERROR_LENGTH) ?? null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { session, loadFailed }: SessionResult =
  supabase && user ? await loadSession(supabase, id) : { session: null, loadFailed: false };

if (loadFailed) {
  Astro.response.status = 500;
} else if (!session) {
  // Not found and "belongs to someone else" look the same: RLS hides other users' rows.
  Astro.response.status = 404;
}

// Analysis: earlier sessions and goals are read in parallel; a failed read degrades the analysis, never the page.
// The stored suggestion is read alongside; when it is missing or unreadable the panel requests one instead.
const [history, profileAndGoals, storedSuggestion] =
  supabase && user && session
    ? await Promise.all([
        loadSessionsUpTo(supabase, session, HISTORY_LIMIT),
        loadProfileAndGoals(supabase, user.id),
        loadStoredSuggestion(supabase, session.id),
      ])
    : [null, null, null];
const initialSuggestion = storedSuggestion?.stored ? storedSuggestionPayload(storedSuggestion.stored) : null;
// Timestamps compare as instants, not strings: PostgREST may format them with different fractional digits.
const editedAfterSuggestion =
  session !== null &&
  storedSuggestion?.stored != null &&
  Date.parse(session.updatedAt) > Date.parse(storedSuggestion.stored.createdAt);
const analysis = session && history ? analyseSession(session, history.loadFailed ? [] : history.sessions) : null;
const isHard =
  session && profileAndGoals && !profileAndGoals.loadFailed ? isHardSession(session, profileAndGoals.goals) : null;

function formatRange(range: NumberRange, unit: string): string {
  return range.min === range.max ? `${String(range.min)} ${unit}` : `${String(range.min)}–${String(range.max)} ${unit}`;
}

const values: { label: string; value: string }[] = session
  ? [
      { label: "Date", value: session.rowedOn },
      { label: "Distance", value: `${String(session.distanceM)} m` },
      { label: "Time", value: formatTime(session.durationS) },
      ...(session.splitsS ? [{ label: "Splits /500 m", value: session.splitsS.map(formatTime).join(" · ") }] : []),
      ...(session.spm ? [{ label: "Stroke rate", value: formatRange(session.spm, "spm") }] : []),
      ...(session.dps ? [{ label: "Distance per stroke", value: formatRange(session.dps, "m") }] : []),
      ...(session.watts === null ? [] : [{ label: "Average watts", value: `${String(session.watts)} W` }]),
      ...(session.boat ? [{ label: "Boat", value: session.boat }] : []),
    ]
  : [];
---

<Layout title="Session">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-md space-y-4 text-white">
      <Topbar />

      {loadFailed ? (
        <ServerError message="Could not load this session — please try again." />
      ) : !session ? (
        <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center backdrop-blur-xl">
          <h1 class="mb-2 text-xl font-semibold">Session not found</h1>
          <p class="text-sm text-blue-100/70">This session does not exist or is not yours.</p>
          <a href="/sessions/new" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
            Log a session
          </a>
        </section>
      ) : (
        <>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
            {session.type === "erg" ? "Erg session" : "Water session"}
          </h1>

          <ServerError message={actionError} />

          <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
            <dl class="space-y-3">
              {values.map(({ label, value }) => (
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-sm text-blue-100/70">{label}</dt>
                  <dd class="text-right font-medium break-words">{value}</dd>
                </div>
              ))}
            </dl>
            {session.comment && (
              <div class="mt-4 border-t border-white/10 pt-4">
                <h2 class="mb-1 text-sm text-blue-100/70">Comment</h2>
                <p class="text-sm whitespace-pre-line break-words">{session.comment}</p>
              </div>
            )}
          </section>

          {analysis && (
            <SessionAnalysis
              analysis={analysis}
              sessionType={session.type}
              historyFailed={history?.loadFailed ?? false}
              isHard={isHard}
            />
          )}

          <SuggestionPanel
            client:load
            sessionId={session.id}
            initial={initialSuggestion}
            editedAfter={editedAfterSuggestion}
          />

          <a
            href="/sessions/new"
            class="block rounded-lg bg-purple-600 px-4 py-3 text-center font-medium text-white transition-colors hover:bg-purple-500"
          >
            Log another session
          </a>
          <div class="flex justify-center gap-6 text-sm">
            <a href={`/sessions/${session.id}/edit`} class="text-purple-300 hover:underline">
              Edit session
            </a>
            <a href="/sessions" class="text-purple-300 hover:underline">
              All sessions
            </a>
          </div>

          <DeleteSessionButton client:load sessionId={session.id} />
        </>
      )}
    </div>
  </div>
</Layout>
